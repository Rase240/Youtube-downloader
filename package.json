{
  "name": "yt-downloader",
  "version": "1.0.0",
  "description": "Premium YouTube Downloader Desktop App",
  "author": "YT Downloader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . \"YT Downloader Pro\" --platform=win32 --arch=x64 --out=dist --overwrite --asar.unpack=\"**/node_modules/ffmpeg-static/**/*\"",
    "build": "electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "axios": "^1.7.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.youtube.downloader",
    "productName": "YT Downloader Pro",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
