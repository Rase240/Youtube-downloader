# Server Configuration
PORT=3000
# Bind address. Use 127.0.0.1 when Nginx (or another reverse proxy) fronts this process.
HOST=127.0.0.1
# Reverse-proxy hops to trust for client IP (1 behind Nginx, 0 if exposed directly).
TRUST_PROXY=1

# REQUIRED: the server refuses to start without it (and rejects the old default).
# Use a long random value, e.g.  openssl rand -base64 24
APP_PASSWORD=change-me-to-a-long-random-password

# Optional: per-download size cap passed to yt-dlp (default 2G)
# MAX_DOWNLOAD_SIZE=2G
# Optional: run with NO authentication (not recommended on a public host)
# ALLOW_NO_AUTH=1
